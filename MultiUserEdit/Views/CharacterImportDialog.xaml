<Window x:Class="MultiUserEdit.Views.CharacterImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="キャラクターの読み込み" Height="252" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="4">
            <TextBlock Text="新しいキャラクターが追加されました" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock x:Name="CharacterNameText" FontSize="12" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" MaxWidth="240" />
                <TextBlock x:Name="OwnerText" FontSize="11" Opacity="0.7" Margin="8,1,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="4,14">
            <RadioButton x:Name="LinkRadio" GroupName="ImportMode" Cursor="Hand" IsChecked="True"
                         Content="既存のキャラクターに紐づける" />
            <ComboBox x:Name="CharacterCombo" Margin="20,6,0,0" Height="26" VerticalContentAlignment="Center"
                      MaxDropDownHeight="260"
                      IsEnabled="{Binding IsChecked, ElementName=LinkRadio}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="4" Height="14" Margin="0,0,7,0" CornerRadius="1" VerticalAlignment="Center">
                                <Border.Background>
                                    <SolidColorBrush Color="{Binding Color}" />
                                </Border.Background>
                            </Border>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
                <ComboBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Bold" Opacity="0.65"
                                           Margin="2,6,0,3" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ComboBox.GroupStyle>
            </ComboBox>

            <RadioButton x:Name="CreateRadio" GroupName="ImportMode" Cursor="Hand" Margin="0,14,0,0"
                         Content="新しいキャラクターとして読み込む" />
            <TextBlock x:Name="CreateHint" FontSize="10" Opacity="0.65" TextWrapping="Wrap" Margin="20,4,0,0"
                       Text="相手の設定をそのまま複製して追加します。素材は共有されたものが使われます。" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0">
            <Button Content="決定" Click="OnDecideClick" Cursor="Hand" Width="90" Height="26" Margin="0" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
