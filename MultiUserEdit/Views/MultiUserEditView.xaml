<UserControl x:Class="MultiUserEdit.Views.MultiUserEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:MultiUserEdit"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:views="clr-namespace:MultiUserEdit.Views"
             xmlns:controls="clr-namespace:MultiUserEdit.Views.Controls"
             xmlns:icons="clr-namespace:YukkuriMovieMaker.Resources.Icons;assembly=YukkuriMovieMaker.Plugin"
             mc:Ignorable="d"
             d:DesignHeight="550" d:DesignWidth="450">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

        <Style TargetType="{x:Type controls:SidebarButton}">
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="4,2" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type controls:SidebarButton}">
                        <Border x:Name="border" Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <StackPanel x:Name="content" Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent">
                                <Path x:Name="icon" Data="{TemplateBinding IconData}" Fill="{TemplateBinding Foreground}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                                <TextBlock x:Name="label" Text="{TemplateBinding Label}" Foreground="{TemplateBinding Foreground}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                            <Trigger Property="controls:SidebarButton.IsCompact" Value="True">
                                <Setter TargetName="label" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="icon" Property="Margin" Value="0" />
                                <Setter TargetName="content" Property="HorizontalAlignment" Value="Center" />
                                <Setter Property="ToolTip" Value="{Binding Label, RelativeSource={RelativeSource Self}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="124" MinWidth="44" MaxWidth="280" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="160" />
        </Grid.ColumnDefinitions>

        <Border x:Name="SidebarBorder" Grid.Column="0" SizeChanged="OnSidebarSizeChanged">
            <DockPanel Margin="0,6">
                <StackPanel DockPanel.Dock="Top" Margin="8,6,8,12">
                    <TextBlock Text="MUE" FontWeight="Bold" FontSize="12" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Style.Triggers>
                                    <Trigger Property="controls:SidebarButton.IsCompact" Value="True">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <StackPanel x:Name="SettingsNavFooter" DockPanel.Dock="Bottom" Margin="0,0,0,6" Visibility="Collapsed">
                    <Separator Margin="8,0,8,4" />
                    <controls:SidebarButton x:Name="SettingsBackButton"
                                            GroupName="SettingsBackGroup"
                                            Label="{x:Static loc:Texts.Back}"
                                            IconData="{DynamicResource {x:Static icons:GeometryKeys.ArrowLeft}}"
                                            Click="OnNavSettingsBackClick" />
                </StackPanel>

                <StackPanel x:Name="MainNavFooter" DockPanel.Dock="Bottom" Margin="0,0,0,6">
                    <Separator Margin="8,0,8,4" />
                    <controls:SidebarButton x:Name="SettingsNavButton"
                                            GroupName="NavGroup"
                                            Label="{x:Static loc:Texts.Settings}"
                                            IconData="{DynamicResource {x:Static icons:GeometryKeys.Cog}}"
                                            Click="OnNavSettingsClick" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>

                <StackPanel x:Name="MainNavPanel">
                    <controls:SidebarButton x:Name="HomeNavButton"
                                            GroupName="NavGroup"
                                            IsChecked="True"
                                            Label="{x:Static loc:Texts.Home}"
                                            IconData="{DynamicResource {x:Static icons:GeometryKeys.Home}}"
                                            Click="OnNavHomeClick" />

                    <controls:SidebarButton x:Name="RulesNavButton"
                                            GroupName="NavGroup"
                                            Label="{x:Static loc:Texts.Rules}"
                                            IconData="{DynamicResource {x:Static icons:GeometryKeys.Shield}}"
                                            Click="OnNavRulesClick" />

                    <controls:SidebarButton x:Name="FilesNavButton"
                                            GroupName="NavGroup"
                                            Label="{x:Static loc:Texts.Files}"
                                            IconData="{DynamicResource {x:Static icons:GeometryKeys.File}}"
                                            Click="OnNavFilesClick" />

                    <controls:SidebarButton x:Name="ScriptsNavButton"
                                            GroupName="NavGroup"
                                            Label="{x:Static loc:Texts.Scripts}"
                                            IconData="{DynamicResource {x:Static icons:GeometryKeys.CommentTextMultipleOutline}}"
                                            Click="OnNavScriptsClick" />
                </StackPanel>

                <StackPanel x:Name="SettingsNavPanel" Visibility="Collapsed">
                    <controls:SidebarButton x:Name="ProfileSettingsNavButton"
                                            GroupName="SettingsNavGroup"
                                            Label="{x:Static loc:Texts.Profile}"
                                            IconData="{DynamicResource {x:Static icons:GeometryKeys.Account}}"
                                            Click="OnNavProfileSettingsClick" />

                    <controls:SidebarButton x:Name="FileSettingsNavButton"
                                            GroupName="SettingsNavGroup"
                                            Label="{x:Static loc:Texts.Files}"
                                            IconData="{DynamicResource {x:Static icons:GeometryKeys.Folder}}"
                                            Click="OnNavFileSettingsClick" />

                    <controls:SidebarButton x:Name="DisplaySettingsNavButton"
                                            GroupName="SettingsNavGroup"
                                            Label="{x:Static loc:Texts.Display}"
                                            IconData="{DynamicResource {x:Static icons:GeometryKeys.EyeOutline}}"
                                            Click="OnNavDisplaySettingsClick" />

                    <controls:SidebarButton x:Name="LinkSettingsNavButton"
                                            GroupName="SettingsNavGroup"
                                            Label="{x:Static loc:Texts.Integration}"
                                            IconData="{DynamicResource {x:Static icons:GeometryKeys.LinkVariant}}"
                                            Click="OnNavLinkSettingsClick" />

                    <controls:SidebarButton x:Name="AboutSettingsNavButton"
                                            GroupName="SettingsNavGroup"
                                            Label="{x:Static loc:Texts.About}"
                                            IconData="{DynamicResource {x:Static icons:GeometryKeys.InformationOutline}}"
                                            Click="OnNavAboutSettingsClick" />
                </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Focusable="False"
                      Cursor="SizeWE" DragCompleted="OnSidebarSplitterDragCompleted">
            <GridSplitter.Template>
                <ControlTemplate TargetType="{x:Type GridSplitter}">
                    <Border Background="Transparent">
                        <Rectangle Width="1" HorizontalAlignment="Center"
                                   Fill="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" />
                    </Border>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <Grid Grid.Column="2">
            <ContentControl x:Name="MainContentControl" />

            <controls:FileTransferBanner VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="0,4,0,0" Panel.ZIndex="99" />
        </Grid>
    </Grid>
</UserControl>
