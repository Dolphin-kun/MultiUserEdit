<UserControl x:Class="MultiUserEdit.Views.Controls.FileTransferBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:icons="clr-namespace:YukkuriMovieMaker.Resources.Icons;assembly=YukkuriMovieMaker.Plugin"
             mc:Ignorable="d" 
             d:DesignWidth="400">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Visibility="{Binding IsTransferring, Converter={StaticResource BoolToVisConverter}}">
        <Border x:Name="BannerBorder" 
                Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" 
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" 
                BorderThickness="1" 
                CornerRadius="4" 
                Margin="8,4" 
                Padding="8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Color="Black" Opacity="0.25" />
            </Border.Effect>
            
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{DynamicResource {x:Static icons:GeometryKeys.ClockOutline}}"
                              Fill="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=Foreground}" 
                              Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding TransferStatusText}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="240" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="{Binding TransferProgress, StringFormat='{}{0:F0}%'}" FontSize="11" Opacity="0.8" Margin="8,0,4,0" VerticalAlignment="Center" />

                    <TextBlock Grid.Column="2" Text="{Binding TransferSpeedText}" FontSize="11" Opacity="0.7" Margin="0,0,8,0" VerticalAlignment="Center" />

                    <Button Grid.Column="3" Click="OnToggleClick" Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="4,2">
                        <Path x:Name="ArrowPath" Data="{DynamicResource {x:Static icons:GeometryKeys.ChevronDown}}" 
                              Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" 
                              Width="10" Height="10" Stretch="Uniform" />
                    </Button>
                </Grid>

                <StackPanel x:Name="DetailsPanel" Margin="0,6,0,0">
                    <ProgressBar Value="{Binding TransferProgress}" Maximum="100" Height="6" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
