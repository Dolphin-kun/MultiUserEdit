<UserControl x:Class="MultiUserEdit.Views.RulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="400">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

        <Style x:Key="SectionBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="RuleCheck" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,4" />
        </Style>

        <Style x:Key="RuleRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,4" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">

            <StackPanel Visibility="{Binding IsHost, Converter={StaticResource BoolToVisConverter}}">
                <Border Style="{StaticResource SectionBorder}">
                    <StackPanel>
                        <TextBlock Text="操作ルール" FontWeight="Bold" FontSize="14" />
                        <TextBlock Text="参加者に許可する操作を決めます。個別に変えたい相手は、ホーム画面の参加者一覧から設定してください。"
                                   FontSize="11" Opacity="0.8" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="15" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionBorder}">
                    <StackPanel>
                        <TextBlock Text="プリセット" Style="{StaticResource SectionTitle}" />
                        <RadioButton x:Name="GlobalFullRadio" Content="フル編集" GroupName="GlobalPresetGroup" Checked="OnGlobalPresetChecked" Cursor="Hand" Margin="0,3" />
                        <RadioButton x:Name="GlobalStandardRadio" Content="標準編集（シーンの操作を制限）" GroupName="GlobalPresetGroup" Checked="OnGlobalPresetChecked" Cursor="Hand" Margin="0,3" />
                        <RadioButton x:Name="GlobalReadOnlyRadio" Content="閲覧のみ" GroupName="GlobalPresetGroup" Checked="OnGlobalPresetChecked" Cursor="Hand" Margin="0,3" />
                        <RadioButton x:Name="GlobalLiveMirrorRadio" Content="ライブミラーリング（閲覧のみ＋ホストに追従）" GroupName="GlobalPresetGroup" Checked="OnGlobalPresetChecked" Cursor="Hand" Margin="0,3" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionBorder}">
                    <StackPanel>
                        <TextBlock Text="アイテム" Style="{StaticResource SectionTitle}" />
                        <CheckBox x:Name="GlobalAddItemsCheck" Content="追加" Style="{StaticResource RuleCheck}" />
                        <CheckBox x:Name="GlobalDeleteItemsCheck" Content="削除" Style="{StaticResource RuleCheck}" />
                        <CheckBox x:Name="GlobalDeleteOthersCheck" Content="他の人が追加したアイテムも削除できる"
                                  IsEnabled="{Binding IsChecked, ElementName=GlobalDeleteItemsCheck}"
                                  Style="{StaticResource RuleCheck}" Margin="18,2,0,4" FontSize="11" />
                        <CheckBox x:Name="GlobalMoveItemsCheck" Content="移動・長さの変更" Style="{StaticResource RuleCheck}" />
                        <CheckBox x:Name="GlobalEditPropsCheck" Content="編集" Style="{StaticResource RuleCheck}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionBorder}">
                    <StackPanel>
                        <TextBlock Text="シーン（タイムライン）" Style="{StaticResource SectionTitle}" />
                        <CheckBox x:Name="GlobalAddScenesCheck" Content="追加" Style="{StaticResource RuleCheck}" />
                        <CheckBox x:Name="GlobalDeleteScenesCheck" Content="削除" Style="{StaticResource RuleCheck}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionBorder}">
                    <StackPanel>
                        <TextBlock Text="その他" Style="{StaticResource SectionTitle}" />
                        <CheckBox x:Name="GlobalShareFilesCheck" Content="素材ファイルの送信" Style="{StaticResource RuleCheck}" />
                        <CheckBox x:Name="GlobalSyncSeekCheck" Content="ホストの再生位置に追従する" Style="{StaticResource RuleCheck}" />
                    </StackPanel>
                </Border>

                <Button Content="全参加者に適用" Click="OnApplyGlobalRulesClick" Cursor="Hand" Height="32" Margin="0,2,0,0" />
            </StackPanel>

            <StackPanel x:Name="GuestPanel">
                <Border Style="{StaticResource SectionBorder}">
                    <StackPanel>
                        <TextBlock Text="あなたの操作ルール" FontWeight="Bold" FontSize="14" />
                        <TextBlock Text="ホストが設定した、あなたに許可されている操作です。" FontSize="11" Opacity="0.8" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionBorder}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="権限レベル" FontSize="12" Opacity="0.8" VerticalAlignment="Center" />
                            <TextBlock x:Name="GuestLevelText" Text="フル編集" FontWeight="Bold" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <Separator Margin="0,0,0,8" />

                        <TextBlock Text="アイテム" Style="{StaticResource SectionTitle}" />
                        <Grid Style="{StaticResource RuleRow}">
                            <TextBlock Text="　追加" FontSize="12" />
                            <TextBlock x:Name="GuestAddText" Text="許可" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Style="{StaticResource RuleRow}">
                            <TextBlock Text="　削除" FontSize="12" />
                            <TextBlock x:Name="GuestDeleteText" Text="許可" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Style="{StaticResource RuleRow}">
                            <TextBlock Text="　　他の人が追加したアイテム" FontSize="11" Opacity="0.85" />
                            <TextBlock x:Name="GuestDeleteOthersText" Text="許可" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Style="{StaticResource RuleRow}">
                            <TextBlock Text="　移動・長さの変更" FontSize="12" />
                            <TextBlock x:Name="GuestMoveText" Text="許可" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Style="{StaticResource RuleRow}">
                            <TextBlock Text="　編集" FontSize="12" />
                            <TextBlock x:Name="GuestPropsText" Text="許可" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" />
                        </Grid>

                        <Separator Margin="0,8" />

                        <TextBlock Text="シーン（タイムライン）" Style="{StaticResource SectionTitle}" />
                        <Grid Style="{StaticResource RuleRow}">
                            <TextBlock Text="　追加" FontSize="12" />
                            <TextBlock x:Name="GuestAddSceneText" Text="許可" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Style="{StaticResource RuleRow}">
                            <TextBlock Text="　削除" FontSize="12" />
                            <TextBlock x:Name="GuestDeleteSceneText" Text="許可" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" />
                        </Grid>

                        <Separator Margin="0,8" />

                        <TextBlock Text="その他" Style="{StaticResource SectionTitle}" />
                        <Grid Style="{StaticResource RuleRow}">
                            <TextBlock Text="　素材ファイルの送信" FontSize="12" />
                            <TextBlock x:Name="GuestShareFilesText" Text="許可" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Style="{StaticResource RuleRow}">
                            <TextBlock Text="　ホストの再生位置に追従" FontSize="12" />
                            <TextBlock x:Name="GuestSyncSeekText" Text="オフ" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
