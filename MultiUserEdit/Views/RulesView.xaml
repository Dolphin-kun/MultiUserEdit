<UserControl x:Class="MultiUserEdit.Views.RulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:MultiUserEdit"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="400">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

        <Style x:Key="SectionBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="RuleCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,4" />
        </Style>

        <Style x:Key="RuleRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,4" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">

            <StackPanel Visibility="{Binding IsHost, Converter={StaticResource BoolToVisConverter}}">
                <Border Style="{StaticResource SectionBorder}">
                    <StackPanel>
                        <TextBlock Text="{x:Static loc:Texts.OperationRules}" FontWeight="Bold" FontSize="14" />
                        <TextBlock Text="{x:Static loc:Texts.OperationRulesDescription}"
                                   FontSize="11" Opacity="0.8" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="15" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionBorder}">
                    <StackPanel>
                        <TextBlock Text="{x:Static loc:Texts.Preset}" Style="{StaticResource SectionTitle}" />
                        <RadioButton x:Name="GlobalFullRadio" Content="{x:Static loc:Texts.FullEdit}" GroupName="GlobalPresetGroup" Checked="OnGlobalPresetChecked" Cursor="Hand" Margin="0,3" />
                        <RadioButton x:Name="GlobalStandardRadio" Content="{x:Static loc:Texts.StandardEditLimitScenes}" GroupName="GlobalPresetGroup" Checked="OnGlobalPresetChecked" Cursor="Hand" Margin="0,3" />
                        <RadioButton x:Name="GlobalReadOnlyRadio" Content="{x:Static loc:Texts.ReadOnly}" GroupName="GlobalPresetGroup" Checked="OnGlobalPresetChecked" Cursor="Hand" Margin="0,3" />
                        <RadioButton x:Name="GlobalLiveMirrorRadio" Content="{x:Static loc:Texts.LiveMirrorFollowHost}" GroupName="GlobalPresetGroup" Checked="OnGlobalPresetChecked" Cursor="Hand" Margin="0,3" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionBorder}">
                    <StackPanel>
                        <TextBlock Text="{x:Static loc:Texts.Item}" Style="{StaticResource SectionTitle}" />
                        <CheckBox x:Name="GlobalAddItemsCheck" Content="{x:Static loc:Texts.Add}" Style="{StaticResource RuleCheck}" />
                        <CheckBox x:Name="GlobalDeleteItemsCheck" Content="{x:Static loc:Texts.Delete}" Style="{StaticResource RuleCheck}" />
                        <CheckBox x:Name="GlobalDeleteOthersCheck" Content="{x:Static loc:Texts.DeleteOthersItems}"
                                  IsEnabled="{Binding IsChecked, ElementName=GlobalDeleteItemsCheck}"
                                  Style="{StaticResource RuleCheck}" Margin="18,2,0,4" FontSize="11" />
                        <CheckBox x:Name="GlobalMoveItemsCheck" Content="{x:Static loc:Texts.MoveAndResize}" Style="{StaticResource RuleCheck}" />
                        <CheckBox x:Name="GlobalEditPropsCheck" Content="{x:Static loc:Texts.Edit}" Style="{StaticResource RuleCheck}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionBorder}">
                    <StackPanel>
                        <TextBlock Text="{x:Static loc:Texts.SceneTimeline}" Style="{StaticResource SectionTitle}" />
                        <CheckBox x:Name="GlobalAddScenesCheck" Content="{x:Static loc:Texts.Add}" Style="{StaticResource RuleCheck}" />
                        <CheckBox x:Name="GlobalDeleteScenesCheck" Content="{x:Static loc:Texts.Delete}" Style="{StaticResource RuleCheck}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionBorder}">
                    <StackPanel>
                        <TextBlock Text="{x:Static loc:Texts.Other}" Style="{StaticResource SectionTitle}" />
                        <CheckBox x:Name="GlobalShareFilesCheck" Content="{x:Static loc:Texts.SendMaterialFiles}" Style="{StaticResource RuleCheck}" />
                        <CheckBox x:Name="GlobalShareVideosCheck" Content="{x:Static loc:Texts.Video}"
                                  IsEnabled="{Binding IsChecked, ElementName=GlobalShareFilesCheck}"
                                  Style="{StaticResource RuleCheck}" Margin="18,2,0,2" FontSize="11" />
                        <CheckBox x:Name="GlobalShareImagesCheck" Content="{x:Static loc:Texts.Image}"
                                  IsEnabled="{Binding IsChecked, ElementName=GlobalShareFilesCheck}"
                                  Style="{StaticResource RuleCheck}" Margin="18,2,0,2" FontSize="11" />
                        <CheckBox x:Name="GlobalShareAudioCheck" Content="{x:Static loc:Texts.Audio}"
                                  IsEnabled="{Binding IsChecked, ElementName=GlobalShareFilesCheck}"
                                  Style="{StaticResource RuleCheck}" Margin="18,2,0,4" FontSize="11" />
                        <CheckBox x:Name="GlobalSyncSeekCheck" Content="{x:Static loc:Texts.FollowHostPlayback}" Style="{StaticResource RuleCheck}" />
                    </StackPanel>
                </Border>

                <Button Content="{x:Static loc:Texts.ApplyToAll}" Click="OnApplyGlobalRulesClick" Cursor="Hand" Height="32" Margin="0,2,0,0" />
            </StackPanel>

            <StackPanel x:Name="GuestPanel">
                <Border Style="{StaticResource SectionBorder}">
                    <StackPanel>
                        <TextBlock Text="{x:Static loc:Texts.YourRules}" FontWeight="Bold" FontSize="14" />
                        <TextBlock Text="{x:Static loc:Texts.YourRulesDescription}" FontSize="11" Opacity="0.8" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionBorder}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="{x:Static loc:Texts.PermissionLevel}" FontSize="12" Opacity="0.8" VerticalAlignment="Center" />
                            <TextBlock x:Name="GuestLevelText" Text="{x:Static loc:Texts.FullEdit}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <Separator Margin="0,0,0,8" />

                        <TextBlock Text="{x:Static loc:Texts.Item}" Style="{StaticResource SectionTitle}" />
                        <Grid Style="{StaticResource RuleRow}">
                            <TextBlock Text="{x:Static loc:Texts.Add}" FontSize="12" Margin="12,0,0,0" />
                            <TextBlock x:Name="GuestAddText" Text="{x:Static loc:Texts.Allowed}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Style="{StaticResource RuleRow}">
                            <TextBlock Text="{x:Static loc:Texts.Delete}" FontSize="12" Margin="12,0,0,0" />
                            <TextBlock x:Name="GuestDeleteText" Text="{x:Static loc:Texts.Allowed}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Style="{StaticResource RuleRow}">
                            <TextBlock Text="{x:Static loc:Texts.OthersAddedItems}" FontSize="11" Margin="22,0,0,0" Opacity="0.85" />
                            <TextBlock x:Name="GuestDeleteOthersText" Text="{x:Static loc:Texts.Allowed}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Style="{StaticResource RuleRow}">
                            <TextBlock Text="{x:Static loc:Texts.MoveAndResize}" FontSize="12" Margin="12,0,0,0" />
                            <TextBlock x:Name="GuestMoveText" Text="{x:Static loc:Texts.Allowed}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Style="{StaticResource RuleRow}">
                            <TextBlock Text="{x:Static loc:Texts.Edit}" FontSize="12" Margin="12,0,0,0" />
                            <TextBlock x:Name="GuestPropsText" Text="{x:Static loc:Texts.Allowed}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" />
                        </Grid>

                        <Separator Margin="0,8" />

                        <TextBlock Text="{x:Static loc:Texts.SceneTimeline}" Style="{StaticResource SectionTitle}" />
                        <Grid Style="{StaticResource RuleRow}">
                            <TextBlock Text="{x:Static loc:Texts.Add}" FontSize="12" Margin="12,0,0,0" />
                            <TextBlock x:Name="GuestAddSceneText" Text="{x:Static loc:Texts.Allowed}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Style="{StaticResource RuleRow}">
                            <TextBlock Text="{x:Static loc:Texts.Delete}" FontSize="12" Margin="12,0,0,0" />
                            <TextBlock x:Name="GuestDeleteSceneText" Text="{x:Static loc:Texts.Allowed}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" />
                        </Grid>

                        <Separator Margin="0,8" />

                        <TextBlock Text="{x:Static loc:Texts.Other}" Style="{StaticResource SectionTitle}" />
                        <Grid Style="{StaticResource RuleRow}">
                            <TextBlock Text="{x:Static loc:Texts.SendMaterialFiles}" FontSize="12" Margin="12,0,0,0" />
                            <TextBlock x:Name="GuestShareFilesText" Text="{x:Static loc:Texts.Allowed}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Style="{StaticResource RuleRow}">
                            <TextBlock Text="{x:Static loc:Texts.Video}" FontSize="11" Margin="22,0,0,0" Opacity="0.85" />
                            <TextBlock x:Name="GuestShareVideosText" Text="{x:Static loc:Texts.Allowed}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Style="{StaticResource RuleRow}">
                            <TextBlock Text="{x:Static loc:Texts.Image}" FontSize="11" Margin="22,0,0,0" Opacity="0.85" />
                            <TextBlock x:Name="GuestShareImagesText" Text="{x:Static loc:Texts.Allowed}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Style="{StaticResource RuleRow}">
                            <TextBlock Text="{x:Static loc:Texts.Audio}" FontSize="11" Margin="22,0,0,0" Opacity="0.85" />
                            <TextBlock x:Name="GuestShareAudioText" Text="{x:Static loc:Texts.Allowed}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Style="{StaticResource RuleRow}">
                            <TextBlock Text="{x:Static loc:Texts.FollowHostPlaybackShort}" FontSize="12" Margin="12,0,0,0" />
                            <TextBlock x:Name="GuestSyncSeekText" Text="{x:Static loc:Texts.Off}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
