<UserControl x:Class="MultiUserEdit.Views.SettingsPages.AboutSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:icons="clr-namespace:YukkuriMovieMaker.Resources.Icons;assembly=YukkuriMovieMaker.Plugin"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="400">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
            <TextBlock Text="情報" FontWeight="Bold" FontSize="14" Margin="0,0,0,12" />

            <!-- バージョン情報（DataContextはコードビハインドでUpdateCheckerを設定） -->
            <Border x:Name="VersionCard" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="バージョン" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8" />

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="現在のバージョン: " FontSize="12" Opacity="0.75" />
                        <TextBlock Grid.Column="1" Text="{Binding CurrentVersion}" FontSize="12" FontWeight="SemiBold" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="最新のバージョン: " FontSize="12" Opacity="0.75" />
                        <TextBlock Grid.Column="1" Text="{Binding LatestVersion}" FontSize="12" FontWeight="SemiBold" />
                    </Grid>

                    <!-- 更新がある場合のみ表示 -->
                    <StackPanel Margin="0,10,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="新しいバージョンが公開されています。" FontSize="11" Foreground="#FF9800" Margin="0,0,0,6" TextWrapping="Wrap" />
                        <Button Command="{Binding OpenUpdateUrlCommand}" Cursor="Hand" Padding="10,4" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource {x:Static icons:GeometryKeys.OpenInNew}}"
                                      Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                      Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0" />
                                <TextBlock Text="ダウンロードページを開く" FontSize="11" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1" CornerRadius="4" Padding="12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Path Data="{DynamicResource {x:Static icons:GeometryKeys.InformationOutline}}"
                              Fill="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=Foreground}"
                              Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" />
                        <TextBlock Text="著作権および利用規約について" FontWeight="SemiBold" FontSize="12" />
                    </StackPanel>
                    <TextBlock Text="転送・共有される素材（画像・動画・音声）の著作権および利用規約は送信者の責任となります。二次配布が禁止されている有料素材などの送信には十分ご注意ください。" FontSize="11" Opacity="0.8" TextWrapping="Wrap" LineHeight="15" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
