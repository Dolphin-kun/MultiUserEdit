<UserControl x:Class="MultiUserEdit.Views.SettingsPages.AboutSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:MultiUserEdit"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:icons="clr-namespace:YukkuriMovieMaker.Resources.Icons;assembly=YukkuriMovieMaker.Plugin"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="400">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
            <TextBlock Text="{x:Static loc:Texts.About}" FontWeight="Bold" FontSize="14" Margin="0,0,0,12" />

            <Border x:Name="VersionCard" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{x:Static loc:Texts.Version}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8" />

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static loc:Texts.CurrentVersion}" Margin="0,0,4,0" FontSize="12" Opacity="0.75" />
                        <TextBlock Grid.Column="1" Text="{Binding DisplayVersion}" FontSize="12" FontWeight="SemiBold" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static loc:Texts.LatestVersion}" Margin="0,0,4,0" FontSize="12" Opacity="0.75" />
                        <TextBlock Grid.Column="1" Text="{Binding LatestVersion}" FontSize="12" FontWeight="SemiBold" />
                    </Grid>

                    <StackPanel Margin="0,10,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="{x:Static loc:Texts.NewVersionAvailable}" FontSize="11" Foreground="#FF9800" Margin="0,0,0,6" TextWrapping="Wrap" />
                        <Button Command="{Binding OpenUpdateUrlCommand}" Cursor="Hand" Padding="10,4" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource {x:Static icons:GeometryKeys.OpenInNew}}"
                                      Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                      Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0" />
                                <TextBlock Text="{x:Static loc:Texts.OpenDownloadPage}" FontSize="11" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1" CornerRadius="4" Padding="12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Path Data="{DynamicResource {x:Static icons:GeometryKeys.InformationOutline}}"
                              Fill="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=Foreground}"
                              Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" />
                        <TextBlock Text="{x:Static loc:Texts.CopyrightTitle}" FontWeight="SemiBold" FontSize="12" />
                    </StackPanel>
                    <TextBlock Text="{x:Static loc:Texts.CopyrightNotice}" FontSize="11" Opacity="0.8" TextWrapping="Wrap" LineHeight="15" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
