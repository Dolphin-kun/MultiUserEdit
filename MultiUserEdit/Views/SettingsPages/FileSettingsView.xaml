<UserControl x:Class="MultiUserEdit.Views.SettingsPages.FileSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:settings="clr-namespace:MultiUserEdit.Settings"
             xmlns:models="clr-namespace:MultiUserEdit.Commons.Models"
             xmlns:icons="clr-namespace:YukkuriMovieMaker.Resources.Icons;assembly=YukkuriMovieMaker.Plugin"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="400">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
            <TextBlock Text="ファイル共有・キャッシュ" FontWeight="Bold" FontSize="14" Margin="0,0,0,12" />

            <!-- 保存形式 -->
            <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="受信ファイルの保存形式" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8" />

                    <RadioButton Content="セッション中一時保存 (終了時に自動消去)"
                                 IsChecked="{Binding Source={x:Static settings:MultiUserEditSettings.Default}, Path=StorageMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static models:FileStorageMode.TemporarySession}}"
                                 Cursor="Hand" FontSize="12" Margin="0,4" 
                                 ToolTip="YMM4終了時にキャッシュ素材を自動で全削除します"/>
                    
                    <RadioButton Content="ストレージに保持 (次回以降もキャッシュ利用)"
                                 IsChecked="{Binding Source={x:Static settings:MultiUserEditSettings.Default}, Path=StorageMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static models:FileStorageMode.Storage}}"
                                 Cursor="Hand" FontSize="12" Margin="0,4" 
                                 ToolTip="一時フォルダに保存して、次回以降もそこから読み込みます"/>
                </StackPanel>
            </Border>

            <!-- 送信の制限 -->
            <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1" CornerRadius="4" Padding="12">
                <StackPanel>
                    <TextBlock Text="送信の制限" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8" />

                    <CheckBox Content="素材ファイルを送信する前に確認メッセージを表示する"
                              IsChecked="{Binding Source={x:Static settings:MultiUserEditSettings.Default}, Path=ConfirmBeforeFileSend}"
                              Cursor="Hand" FontSize="12" Margin="0,4" 
                              ToolTip="他のユーザーに動画・画像・音声等のファイルが自動送信される前に確認ダイアログを表示します"/>

                    <Grid Margin="0,8,0,4">
                        <TextBlock Text="共有可能な拡張子" FontSize="11" Opacity="0.75" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Click="OnCheckAllClick" Cursor="Hand" Padding="6,2" Margin="0" Content="すべて選択" FontSize="10" />
                            <Button Click="OnUncheckAllClick" Cursor="Hand" Padding="6,2" Margin="0" Content="すべて解除" FontSize="10" />
                            <Button Click="OnResetToDefaultClick" Cursor="Hand" Padding="6,2" Content="既定に戻す" FontSize="10" />
                        </StackPanel>
                    </Grid>

                    <!-- 種類ごとにまとめたチェックボックス一覧 -->
                    <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1" CornerRadius="3">
                        <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      PreviewMouseWheel="OnNestedScrollPreviewMouseWheel">
                            <ItemsControl x:Name="ExtensionList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Opacity="0.7" Margin="4" />
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                        <GroupStyle.Panel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </GroupStyle.Panel>
                                    </GroupStyle>
                                </ItemsControl.GroupStyle>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,12,2">
                                            <CheckBox IsChecked="{Binding IsEnabled}" Content="{Binding Extension}"
                                                      FontSize="11" Cursor="Hand" VerticalContentAlignment="Center" />
                                            <Button Click="OnRemoveExtensionClick" Cursor="Hand" ToolTip="この形式を一覧から削除"
                                                    Background="Transparent" BorderThickness="0" Padding="3,0" Margin="2,0,0,0"
                                                    Visibility="{Binding IsCustom, Converter={StaticResource BoolToVisConverter}}">
                                                <Path Data="{DynamicResource {x:Static icons:GeometryKeys.Close}}"
                                                      Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                      Width="8" Height="8" Stretch="Uniform" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- 一覧に無い形式の追加 -->
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NewExtensionBox" KeyDown="OnNewExtensionKeyDown"
                                 PreviewMouseWheel="OnInputPreviewMouseWheel"
                                 Height="26" Padding="6,3" FontSize="11" VerticalContentAlignment="Center" MaxLength="12" Margin="0" />
                        <Button Grid.Column="1" Click="OnAddExtensionClick" Cursor="Hand" Content="追加"
                                Width="52" Height="26" FontSize="11" Margin="0" />
                    </Grid>
                    <TextBlock Text="※一覧に無い形式（例: .m2v）はここから追加できます。未許可の拡張子 (.exe, .bat など) は転送されず自動ブロックされます。"
                               FontSize="10" Opacity="0.65" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
