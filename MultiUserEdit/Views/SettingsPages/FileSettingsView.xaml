<UserControl x:Class="MultiUserEdit.Views.SettingsPages.FileSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ymm="clr-namespace:YukkuriMovieMaker.Controls;assembly=YukkuriMovieMaker.Controls"
             xmlns:loc="clr-namespace:MultiUserEdit"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:settings="clr-namespace:MultiUserEdit.Settings"
             xmlns:models="clr-namespace:MultiUserEdit.Commons.Models"
             xmlns:icons="clr-namespace:YukkuriMovieMaker.Resources.Icons;assembly=YukkuriMovieMaker.Plugin"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="400">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
            <TextBlock Text="{x:Static loc:Texts.FileSharingCache}" FontWeight="Bold" FontSize="14" Margin="0,0,0,12" />

            <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{x:Static loc:Texts.ReceivedFileStorage}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8" />

                    <RadioButton Content="{x:Static loc:Texts.TemporaryStorage}"
                                 IsChecked="{Binding Source={x:Static settings:MultiUserEditSettings.Default}, Path=StorageMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static models:FileStorageMode.TemporarySession}}"
                                 Cursor="Hand" FontSize="12" Margin="0,4" 
                                 ToolTip="{x:Static loc:Texts.TemporaryStorageTip}"/>
                    
                    <RadioButton Content="{x:Static loc:Texts.KeepStorage}"
                                 IsChecked="{Binding Source={x:Static settings:MultiUserEditSettings.Default}, Path=StorageMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static models:FileStorageMode.Storage}}"
                                 Cursor="Hand" FontSize="12" Margin="0,4" 
                                 ToolTip="{x:Static loc:Texts.KeepStorageTip}"/>

                    <Separator Margin="0,8" />

                    <Grid Margin="0,4" ToolTip="{x:Static loc:Texts.ConfirmLargeReceiveTip}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static loc:Texts.ConfirmLargeReceive}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0" FontSize="12" />
                        <ymm:ToggleSlider x:Name="ConfirmLargeReceiveCheck" Grid.Column="1" VerticalAlignment="Center" Value="{Binding Source={x:Static settings:MultiUserEditSettings.Default}, Path=ConfirmLargeFileReceive}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="18,2,0,0"
                                IsEnabled="{Binding Value, ElementName=ConfirmLargeReceiveCheck}">
                        <TextBlock Text="{x:Static loc:Texts.ConfirmSize}" FontSize="11" Opacity="0.75" VerticalAlignment="Center" />
                        <TextBox Text="{Binding Source={x:Static settings:MultiUserEditSettings.Default}, Path=LargeFileConfirmMegaBytes, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewMouseWheel="OnInputPreviewMouseWheel"
                                 Width="56" Height="24" Margin="8,0,4,0" Padding="4,2" FontSize="11"
                                 VerticalContentAlignment="Center" TextAlignment="Right" MaxLength="6" />
                        <TextBlock Text="{x:Static loc:Texts.MBOrMore}" FontSize="11" Opacity="0.75" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1" CornerRadius="4" Padding="12">
                <StackPanel>
                    <TextBlock Text="{x:Static loc:Texts.SendLimits}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8" />

                    <Grid Margin="0,4" ToolTip="{x:Static loc:Texts.ConfirmBeforeSendTip}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static loc:Texts.ConfirmBeforeSend}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0" FontSize="12" />
                        <ymm:ToggleSlider Grid.Column="1" VerticalAlignment="Center" Value="{Binding Source={x:Static settings:MultiUserEditSettings.Default}, Path=ConfirmBeforeFileSend}" />
                    </Grid>

                    <Grid Margin="0,4" ToolTip="{x:Static loc:Texts.UseDirectTransferTip}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static loc:Texts.UseDirectTransfer}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0" FontSize="12" />
                        <ymm:ToggleSlider Grid.Column="1" VerticalAlignment="Center" Value="{Binding Source={x:Static settings:MultiUserEditSettings.Default}, Path=UseDirectTransfer}" />
                    </Grid>

                    <Grid Margin="0,8,0,4">
                        <TextBlock Text="{x:Static loc:Texts.ShareableExtensions}" FontSize="11" Opacity="0.75" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Click="OnCheckAllClick" Cursor="Hand" ToolTip="{x:Static loc:Texts.SelectAll}"
                                    Background="Transparent" BorderThickness="0" Padding="5,2" Margin="0">
                                <Path Data="{DynamicResource {x:Static icons:GeometryKeys.CheckboxMultipleMarkedOutline}}"
                                      Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                      Width="14" Height="14" Stretch="Uniform" />
                            </Button>
                            <Button Click="OnUncheckAllClick" Cursor="Hand" ToolTip="{x:Static loc:Texts.DeselectAll}"
                                    Background="Transparent" BorderThickness="0" Padding="5,2" Margin="0">
                                <Path Data="{DynamicResource {x:Static icons:GeometryKeys.CheckboxMultipleBlankOutline}}"
                                      Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                      Width="14" Height="14" Stretch="Uniform" />
                            </Button>
                            <Button Click="OnResetToDefaultClick" Cursor="Hand" ToolTip="{x:Static loc:Texts.ResetToDefault}"
                                    Background="Transparent" BorderThickness="0" Padding="5,2" Margin="0">
                                <Path Data="{DynamicResource {x:Static icons:GeometryKeys.Restore}}"
                                      Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                      Width="14" Height="14" Stretch="Uniform" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1" CornerRadius="3">
                        <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      PreviewMouseWheel="OnNestedScrollPreviewMouseWheel">
                            <ItemsControl x:Name="ExtensionList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Opacity="0.7" Margin="4" />
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                        <GroupStyle.Panel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </GroupStyle.Panel>
                                    </GroupStyle>
                                </ItemsControl.GroupStyle>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,12,2">
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Extension}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0" FontSize="11" />
                                                <ymm:ToggleSlider Grid.Column="1" VerticalAlignment="Center" Value="{Binding IsEnabled}" />
                                            </Grid>
                                            <Button Click="OnRemoveExtensionClick" Cursor="Hand" ToolTip="{x:Static loc:Texts.RemoveFormat}"
                                                    Background="Transparent" BorderThickness="0" Padding="3,0" Margin="2,0,0,0"
                                                    Visibility="{Binding IsCustom, Converter={StaticResource BoolToVisConverter}}">
                                                <Path Data="{DynamicResource {x:Static icons:GeometryKeys.Close}}"
                                                      Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                      Width="8" Height="8" Stretch="Uniform" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NewExtensionBox" KeyDown="OnNewExtensionKeyDown"
                                 PreviewMouseWheel="OnInputPreviewMouseWheel"
                                 Height="26" Padding="6,3" FontSize="11" VerticalContentAlignment="Center" MaxLength="12" Margin="0" />
                        <Button Grid.Column="1" Click="OnAddExtensionClick" Cursor="Hand" Content="{x:Static loc:Texts.Add}"
                                Width="52" Height="26" FontSize="11" Margin="0" />
                    </Grid>
                    <TextBlock Text="{x:Static loc:Texts.AddFormatHint}"
                               FontSize="10" Opacity="0.65" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
