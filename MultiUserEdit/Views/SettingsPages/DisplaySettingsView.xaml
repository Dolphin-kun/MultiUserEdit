<UserControl x:Class="MultiUserEdit.Views.SettingsPages.DisplaySettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ymm="clr-namespace:YukkuriMovieMaker.Controls;assembly=YukkuriMovieMaker.Controls"
             xmlns:loc="clr-namespace:MultiUserEdit"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:settings="clr-namespace:MultiUserEdit.Settings"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="400">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
            <TextBlock Text="{x:Static loc:Texts.Display}" FontWeight="Bold" FontSize="14" Margin="0,0,0,12" />

            <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1" CornerRadius="4" Padding="12">
                <StackPanel>
                    <TextBlock Text="{x:Static loc:Texts.Timeline}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8" />

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static loc:Texts.ShowOperatorName}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0" FontSize="12" />
                        <ymm:ToggleSlider Grid.Column="1" VerticalAlignment="Center" Value="{Binding Source={x:Static settings:MultiUserEditSettings.Default}, Path=ShowOperatorNames}" />
                    </Grid>
                    <TextBlock FontSize="11" Opacity="0.7" Margin="20,2,0,0" TextWrapping="Wrap"
                               Text="{x:Static loc:Texts.ShowOperatorNameHint}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
