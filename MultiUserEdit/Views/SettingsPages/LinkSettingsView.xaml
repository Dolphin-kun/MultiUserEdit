<UserControl x:Class="MultiUserEdit.Views.SettingsPages.LinkSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:MultiUserEdit"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:MultiUserEdit.Views.Converters"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="400">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
            <TextBlock Text="{x:Static loc:Texts.Integration}" FontWeight="Bold" FontSize="14" Margin="0,0,0,12" />

            <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1" CornerRadius="4" Padding="12">
                <StackPanel>
                    <TextBlock Text="{x:Static loc:Texts.WebDeepLink}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                    <TextBlock Text="{x:Static loc:Texts.WebDeepLinkDescription}" FontSize="10" Opacity="0.65" TextWrapping="Wrap" Margin="0,0,0,10" />

                    <StackPanel Orientation="Horizontal" Margin="0,2,0,8">
                        <TextBlock Text="{x:Static loc:Texts.CurrentStatus}" Margin="0,0,4,0" FontSize="12" Opacity="0.8" />
                        <TextBlock FontSize="12" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsProtocolRegistered}" Value="True">
                                            <Setter Property="Text" Value="{x:Static loc:Texts.Registered}" />
                                            <Setter Property="Foreground" Value="#4CAF50" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsProtocolRegistered}" Value="False">
                                            <Setter Property="Text" Value="{x:Static loc:Texts.NotRegistered}" />
                                            <Setter Property="Foreground" Value="#FF9800" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding RegisterProtocolCommand}" Cursor="Hand" Padding="10,4" Margin="0,0,8,0" Content="{x:Static loc:Texts.Reregister}"
                                Visibility="{Binding IsProtocolRegistered, Converter={StaticResource InverseBoolToVisConverter}}" />
                        <Button Command="{Binding UnregisterProtocolCommand}" Cursor="Hand" Padding="10,4" Content="{x:Static loc:Texts.Unregister}"
                                Visibility="{Binding IsProtocolRegistered, Converter={StaticResource BoolToVisConverter}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
