<Window x:Class="MultiUserEdit.Views.UserProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MultiUserEdit"
        xmlns:icons="clr-namespace:YukkuriMovieMaker.Resources.Icons;assembly=YukkuriMovieMaker.Plugin"
        Title="{x:Static loc:Texts.UserInfo}" Height="440" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Style>
        <Style TargetType="{x:Type Window}" BasedOn="{StaticResource {x:Type Window}}" />
    </Window.Style>

    <Window.Resources>
        <Style x:Key="EqualWidthTabItemStyle" TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />  
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="14,12,14,10">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="ColorSwatch" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock x:Name="UserNameText" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="230" />
                <Border x:Name="RoleBadge" Margin="8,0,0,0" Padding="6,1" CornerRadius="3" VerticalAlignment="Center"
                        BorderThickness="1" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                    <TextBlock x:Name="RoleText" FontSize="10" Opacity="0.85" />
                </Border>
            </StackPanel>

            <TextBlock x:Name="DescriptionText" FontSize="11" Opacity="0.8" TextWrapping="Wrap"
                       MaxHeight="32" TextTrimming="CharacterEllipsis" Margin="20,4,0,0" />

            <StackPanel Margin="20,10,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                    <Ellipse x:Name="StatusDot" Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,5,0" />
                    <TextBlock x:Name="StatusLabel" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{x:Static loc:Texts.EditTime}" Margin="0,0,4,0" FontSize="12" Opacity="0.75" />
                    <TextBlock x:Name="EditDurationText" FontSize="12" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel x:Name="TotalDurationPanel" Orientation="Horizontal" Margin="0,3,0,0">
                    <TextBlock Text="{x:Static loc:Texts.TotalTime}" Margin="0,0,4,0" FontSize="12" Opacity="0.75" />
                    <TextBlock x:Name="TotalDurationText" FontSize="12" FontWeight="SemiBold" />
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <Separator Grid.Row="1" Margin="0" />

        <Grid Grid.Row="2" Margin="0">
            <TabControl x:Name="Tabs" BorderThickness="1">
                <TabItem x:Name="ProfileTab" Header="{x:Static loc:Texts.Profile}" Style="{StaticResource EqualWidthTabItemStyle}"
                         HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <StackPanel Margin="10,8,10,8">
                        <TextBlock Text="{x:Static loc:Texts.DisplayName}" FontSize="11" Opacity="0.75" Margin="0,0,0,3" />
                        <TextBox x:Name="UserNameBox" Height="26" Padding="6,3" VerticalContentAlignment="Center" MaxLength="32" />

                        <TextBlock Text="{x:Static loc:Texts.SelfIntroduction}" FontSize="11" Opacity="0.75" Margin="0,10,0,3" />
                        <TextBox x:Name="DescriptionBox" Height="72" Padding="6,4" TextWrapping="Wrap"
                                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
                        <TextBlock x:Name="DescriptionHint" FontSize="10" Opacity="0.6" Margin="0,3,0,0" TextWrapping="Wrap" />

                        <TextBlock x:Name="ReadOnlyNote" Text="{x:Static loc:Texts.CannotEditOthersProfile}"
                                   FontSize="10" Opacity="0.65" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </TabItem>

                <TabItem x:Name="PermissionTab" Header="{x:Static loc:Texts.Permission}" Style="{StaticResource EqualWidthTabItemStyle}"
                         HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PermissionPanel" Margin="10,8,10,8">
                            <TextBlock Text="{x:Static loc:Texts.PermissionPreset}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                            <RadioButton x:Name="FullRadio" Content="{x:Static loc:Texts.FullEditDetail}" GroupName="PresetGroup" Checked="OnPresetChecked" Cursor="Hand" Margin="0,2" />
                            <RadioButton x:Name="StandardRadio" Content="{x:Static loc:Texts.StandardEditDetail}" GroupName="PresetGroup" Checked="OnPresetChecked" Cursor="Hand" Margin="0,2" />
                            <RadioButton x:Name="ReadOnlyRadio" Content="{x:Static loc:Texts.ReadOnlyDetail}" GroupName="PresetGroup" Checked="OnPresetChecked" Cursor="Hand" Margin="0,2" />
                            <RadioButton x:Name="LiveMirrorRadio" Content="{x:Static loc:Texts.LiveMirrorDetail}" GroupName="PresetGroup" Checked="OnPresetChecked" Cursor="Hand" Margin="0,2" />

                            <Separator Margin="0,10" />

                            <TextBlock Text="{x:Static loc:Texts.CustomizeRules}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                            <CheckBox x:Name="AddItemsCheck" Content="{x:Static loc:Texts.AllowAddItems}" Cursor="Hand" Margin="0,3" />
                            <CheckBox x:Name="DeleteItemsCheck" Content="{x:Static loc:Texts.AllowDeleteItems}" Cursor="Hand" Margin="0,3" />
                            <CheckBox x:Name="DeleteOthersCheck" Content="{x:Static loc:Texts.AllowDeleteOthersItems}"
                                      IsEnabled="{Binding IsChecked, ElementName=DeleteItemsCheck}"
                                      Cursor="Hand" Margin="18,2,0,3" FontSize="11" />
                            <CheckBox x:Name="MoveItemsCheck" Content="{x:Static loc:Texts.AllowMoveItems}" Cursor="Hand" Margin="0,3" />
                            <CheckBox x:Name="EditPropsCheck" Content="{x:Static loc:Texts.AllowEditItems}" Cursor="Hand" Margin="0,3" />
                            <CheckBox x:Name="AddScenesCheck" Content="{x:Static loc:Texts.AllowAddScenes}" Cursor="Hand" Margin="0,3" />
                            <CheckBox x:Name="DeleteScenesCheck" Content="{x:Static loc:Texts.AllowDeleteScenes}" Cursor="Hand" Margin="0,3" />
                            <CheckBox x:Name="ShareFilesCheck" Content="{x:Static loc:Texts.AllowSendFiles}" Cursor="Hand" Margin="0,3" />
                            <CheckBox x:Name="ShareVideosCheck" Content="{x:Static loc:Texts.Video}" IsEnabled="{Binding IsChecked, ElementName=ShareFilesCheck}" Cursor="Hand" Margin="18,2,0,2" FontSize="11" />
                            <CheckBox x:Name="ShareImagesCheck" Content="{x:Static loc:Texts.Image}" IsEnabled="{Binding IsChecked, ElementName=ShareFilesCheck}" Cursor="Hand" Margin="18,2,0,2" FontSize="11" />
                            <CheckBox x:Name="ShareAudioCheck" Content="{x:Static loc:Texts.Audio}" IsEnabled="{Binding IsChecked, ElementName=ShareFilesCheck}" Cursor="Hand" Margin="18,2,0,3" FontSize="11" />
                            <CheckBox x:Name="SyncSeekCheck" Content="{x:Static loc:Texts.AutoFollowHost}" Cursor="Hand" Margin="0,3" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <Button x:Name="KickButton" Click="OnKickClick" Cursor="Hand"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,2,0"
                    Padding="6,3" Background="Transparent" BorderThickness="0" ToolTip="{x:Static loc:Texts.Kick}">
                <Path Data="{DynamicResource {x:Static icons:GeometryKeys.AccountRemove}}" Fill="#FF5252"
                      Width="14" Height="14" Stretch="Uniform" />
            </Button>
        </Grid>

        <Button x:Name="SyncFromButton" Grid.Row="3" Click="OnSyncFromClick" Cursor="Hand"
                HorizontalAlignment="Left" VerticalAlignment="Bottom" Height="26" Padding="8,0" Margin="0">
            <StackPanel Orientation="Horizontal">
                <Path Data="{DynamicResource {x:Static icons:GeometryKeys.Refresh}}"
                      Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                      Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" />
                <TextBlock Text="{x:Static loc:Texts.SyncFromThisUser}" VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0">
            <Button Content="{x:Static loc:Texts.Apply}" Click="OnApplyClick" Cursor="Hand" Width="90" Height="26" Margin="0" IsDefault="True" />
            <Button Content="{x:Static loc:Texts.Cancel}" Click="OnCancelClick" Cursor="Hand" Width="90" Height="26" Margin="0" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
