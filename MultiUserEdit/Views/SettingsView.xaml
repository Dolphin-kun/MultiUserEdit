<UserControl x:Class="MultiUserEdit.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:settings="clr-namespace:MultiUserEdit.Settings"
             xmlns:models="clr-namespace:MultiUserEdit.Commons.Models"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="400">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
            <!-- ユーザープロフィール設定 -->
            <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="プロフィール設定" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8" />
                    <TextBlock Text="参加者に表示される表示名を指定します。" FontSize="11" Opacity="0.8" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" PreviewMouseWheel="OnInputPreviewMouseWheel" Height="28" Padding="6,4" FontSize="12" VerticalContentAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ファイル共有・キャッシュ設定 -->
            <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="ファイル共有・キャッシュ設定" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8" />
                    <TextBlock Text="共有された動画・画像・音声ファイルのローカル保存形式を指定します。" FontSize="11" Opacity="0.8" TextWrapping="Wrap" Margin="0,0,0,10" />

                    <StackPanel Margin="0,2,0,0">
                        <RadioButton Content="セッション中一時保存 (終了時に自動消去)" 
                                     IsChecked="{Binding Source={x:Static settings:MultiUserEditSettings.Default}, Path=StorageMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static models:FileStorageMode.TemporarySession}}"
                                     Cursor="Hand"
                                     FontSize="12" Margin="0,4" />
                        <TextBlock Text="YMM4終了時にキャッシュ素材を自動全削除しPC容量を圧迫しません。" FontSize="10" Opacity="0.65" Margin="20,0,0,8" />

                        <RadioButton Content="ストレージに保持 (次回以降もキャッシュ利用)" 
                                     IsChecked="{Binding Source={x:Static settings:MultiUserEditSettings.Default}, Path=StorageMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static models:FileStorageMode.Storage}}"
                                     Cursor="Hand"
                                     FontSize="12" Margin="0,4" />
                        <TextBlock Text="Tempフォルダに保存し、次回以降も高速読み込みします。" FontSize="10" Opacity="0.65" Margin="20,0,0,8" />

                        <Separator Margin="0,8,0,8" />

                        <CheckBox Content="素材ファイルを送信する前に確認メッセージを表示する" 
                                  IsChecked="{Binding Source={x:Static settings:MultiUserEditSettings.Default}, Path=ConfirmBeforeFileSend}"
                                  Cursor="Hand" FontSize="12" Margin="0,4" />
                        <TextBlock Text="他のユーザーに動画・画像・音声等のファイルが自動送信される前に確認ダイアログを表示します。" FontSize="10" Opacity="0.65" Margin="20,0,0,8" TextWrapping="Wrap" />

                        <TextBlock Text="共有可能なファイル拡張子 (カンマ区切り):" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,4" />
                        <TextBox Text="{Binding Source={x:Static settings:MultiUserEditSettings.Default}, Path=AllowedExtensions, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewMouseWheel="OnInputPreviewMouseWheel"
                                 Height="28" Padding="6,4" FontSize="12" VerticalContentAlignment="Center" />
                        <TextBlock Text="※未許可の拡張子 (.exe, .bat など) のファイルは転送されず自動ブロックされます。" FontSize="10" Opacity="0.65" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Webディープリンク設定 -->
            <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Webディープリンク設定 (ymm4-multi-user-edit://)" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8" />
                    <TextBlock Text="ブラウザからワンクリックでYMM4を開いて自動参加するためのプロトコル設定です。（起動時に自動登録されます）" FontSize="11" Opacity="0.8" TextWrapping="Wrap" Margin="0,0,0,10" />

                    <StackPanel Orientation="Horizontal" Margin="0,2,0,8">
                        <TextBlock Text="現在のステータス: " FontSize="12" Opacity="0.8" />
                        <TextBlock FontSize="12" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsProtocolRegistered}" Value="True">
                                            <Setter Property="Text" Value="登録済み (有効)" />
                                            <Setter Property="Foreground" Value="#4CAF50" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsProtocolRegistered}" Value="False">
                                            <Setter Property="Text" Value="未登録" />
                                            <Setter Property="Foreground" Value="#FF9800" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding RegisterProtocolCommand}" Cursor="Hand" Padding="10,4" Margin="0,0,8,0" Content="再登録する">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsProtocolRegistered}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Command="{Binding UnregisterProtocolCommand}" Cursor="Hand" Padding="10,4" Content="登録を削除・解除">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsProtocolRegistered}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 注意事項 & ライセンス -->
            <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1" CornerRadius="4" Padding="12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Path Data="M11,15H13V17H11V15M11,7H13V13H11V7M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 12,2Z" Fill="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=Foreground}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" />
                        <TextBlock Text="著作権および利用規約について" FontWeight="SemiBold" FontSize="12" />
                    </StackPanel>
                    <TextBlock Text="転送・共有される素材（画像・動画・音声）の著作権および利用規約は送信者の責任となります。二次配布が禁止されている有料素材などの送信には十分ご注意ください。" FontSize="11" Opacity="0.8" TextWrapping="Wrap" LineHeight="15" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
