<UserControl x:Class="MultiUserEdit.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:MultiUserEdit"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:icons="clr-namespace:YukkuriMovieMaker.Resources.Icons;assembly=YukkuriMovieMaker.Plugin"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="400">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
            <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{x:Static loc:Texts.PluginName}" FontWeight="Bold" FontSize="14" />
                        <TextBlock Text="{Binding StatusText}" FontSize="12" Margin="0,4,0,0" Opacity="0.8" />
                    </StackPanel>

                    <Border Grid.Column="1" VerticalAlignment="Center" Padding="8,4" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                        <TextBlock FontSize="11" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Text" Value="{x:Static loc:Texts.Connected}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                            <Setter Property="Text" Value="{x:Static loc:Texts.NotConnected}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>

            <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1"
                    CornerRadius="4" Padding="12" Margin="0,0,0,12"
                    Visibility="{Binding HasDivergenceWarning, Converter={StaticResource BoolToVisConverter}}">
                <StackPanel>
                    <TextBlock Text="{Binding DivergenceWarningText}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock FontSize="11" Opacity="0.8" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="{x:Static loc:Texts.DivergenceHint}" />

                    <WrapPanel HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="{x:Static loc:Texts.SyncDataAction}" Command="{Binding SyncNowCommand}"
                                Cursor="Hand" Padding="10,4" Margin="0,0,6,0" />
                        <Button Content="{x:Static loc:Texts.Close}" Command="{Binding DismissDivergenceWarningCommand}"
                                Cursor="Hand" Padding="10,4" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border x:Name="UpdateNotice" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1"
                    CornerRadius="4" Padding="12" Margin="0,0,0,12"
                    Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisConverter}}">
                <StackPanel>
                    <TextBlock FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                               Text="{Binding LatestVersion, Mode=OneWay, StringFormat={x:Static loc:Texts.NewVersionPublishedFormat}}" />
                    <TextBlock FontSize="11" Opacity="0.8" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="{x:Static loc:Texts.LatestOnlyPleaseUpdate}" />

                    <Button Content="{x:Static loc:Texts.OpenUpdatePage}" Command="{Binding OpenUpdateUrlCommand}"
                            Cursor="Hand" Padding="10,4" Margin="0,10,0,0" HorizontalAlignment="Right" />
                </StackPanel>
            </Border>

            <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{x:Static loc:Texts.Room}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10" />

                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <WrapPanel Margin="0,0,0,8">
                            <RadioButton GroupName="RoomKind" Cursor="Hand" Margin="0,0,12,4"
                                         IsChecked="{Binding IsNormalRoomSelected, Mode=TwoWay}"
                                         ToolTip="{x:Static loc:Texts.NormalRoomTip}">
                                <TextBlock Text="{x:Static loc:Texts.NormalRoomLabel}" FontSize="12" VerticalAlignment="Center" />
                            </RadioButton>

                            <RadioButton GroupName="RoomKind" Cursor="Hand" Margin="0,0,0,4"
                                         IsChecked="{Binding IsKeptRoomSelected, Mode=TwoWay}"
                                         ToolTip="{x:Static loc:Texts.KeptRoomTip}">
                                <TextBlock Text="{x:Static loc:Texts.KeptRoomLabel}" FontSize="12" VerticalAlignment="Center" />
                            </RadioButton>
                        </WrapPanel>

                        <Button Command="{Binding CreateRoomCommand}" Cursor="Hand" Height="32">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{DynamicResource {x:Static icons:GeometryKeys.Plus}}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                                <TextBlock Text="{x:Static loc:Texts.CreateRoom}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <TextBlock Text="{x:Static loc:Texts.JoinExistingRoom}" FontSize="12" Margin="0,10,0,6" Opacity="0.85" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <PasswordBox x:Name="InputRoomIdPasswordBox" PasswordChanged="OnInputRoomIdPasswordChanged"
                                         PreviewMouseWheel="OnInputPreviewMouseWheel"
                                         Height="25" Padding="6,4" FontSize="12" VerticalContentAlignment="Center" Margin="0" />

                            <Button Grid.Column="1" Command="{Binding JoinFromClipboardCommand}" Cursor="Hand"
                                    Width="30" Height="25" Margin="0" Padding="0" ToolTip="{x:Static loc:Texts.JoinFromClipboard}">
                                <Path Data="{DynamicResource {x:Static icons:GeometryKeys.ClipboardOutline}}"
                                      Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                      Width="14" Height="14" Stretch="Uniform" />
                            </Button>

                            <Button Grid.Column="2" Command="{Binding JoinRoomCommand}" Click="OnJoinRoomClick" Cursor="Hand"
                                    Content="{x:Static loc:Texts.Join}" Width="60" Height="25" Margin="0" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisConverter}}">
                        <Button Command="{Binding SyncNowCommand}" Cursor="Hand" Height="32" Margin="0,0,0,6"
                                ToolTip="{x:Static loc:Texts.SyncDataTip}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{DynamicResource {x:Static icons:GeometryKeys.Refresh}}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                                <TextBlock Text="{x:Static loc:Texts.SyncDataAction}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding DisconnectCommand}" Cursor="Hand" Height="32" Content="{x:Static loc:Texts.Disconnect}" />

                        <Button Command="{Binding DeleteKeptRoomCommand}" Cursor="Hand" Height="32" Margin="0,6,0,0"
                                Content="{x:Static loc:Texts.DeleteKeptRoom}"
                                Visibility="{Binding IsKeptRoomOwner, Converter={StaticResource BoolToVisConverter}}" />
                    </StackPanel>

                    <Separator Margin="0,10,0,8" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding CopyRoomIdCommand}" Cursor="Hand" Padding="6,3" Margin="0,0,4,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource {x:Static icons:GeometryKeys.ContentCopy}}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0" />
                                <TextBlock Text="{x:Static loc:Texts.CopyId}" FontSize="11" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CopyInviteLinkCommand}" Cursor="Hand" Padding="6,3">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource {x:Static icons:GeometryKeys.LinkVariant}}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0" />
                                <TextBlock Text="{x:Static loc:Texts.CopyInviteLink}" FontSize="11" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="{x:Static loc:Texts.ParticipantList}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Participants.Count, StringFormat={x:Static loc:Texts.ParticipantCount}}" FontSize="12" Opacity="0.75" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Participants}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="6,4" Margin="0,2" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Ellipse Grid.Column="0" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="{x:Static loc:Texts.UserColor}">
                                            <Ellipse.Fill>
                                                <SolidColorBrush Color="{Binding ThemeColor}" />
                                            </Ellipse.Fill>
                                        </Ellipse>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding UserName}" FontSize="12" FontWeight="SemiBold" />
                                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                                <Ellipse Width="6" Height="6" Fill="{Binding StatusBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                <TextBlock Text="{Binding StatusText}" FontSize="10" Opacity="0.75" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RoleText}" FontSize="11" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <Button Click="OnParticipantMenuClick"
                                                    Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="4,2" ToolTip="{x:Static loc:Texts.OpenUserInfo}">
                                                <Path Data="{DynamicResource {x:Static icons:GeometryKeys.DotsVertical}}"
                                                      Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                      Width="13" Height="13" Stretch="Uniform" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
