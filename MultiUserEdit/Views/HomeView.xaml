<UserControl x:Class="MultiUserEdit.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:icons="clr-namespace:YukkuriMovieMaker.Resources.Icons;assembly=YukkuriMovieMaker.Plugin"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="400">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
            <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="共同編集" FontWeight="Bold" FontSize="14" />
                        <TextBlock Text="{Binding StatusText}" FontSize="12" Margin="0,4,0,0" Opacity="0.8" />
                    </StackPanel>

                    <Border Grid.Column="1" VerticalAlignment="Center" Padding="8,4" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                        <TextBlock FontSize="11" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Text" Value="接続中" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                            <Setter Property="Text" Value="未接続" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="UpdateNotice" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1"
                    CornerRadius="4" Padding="12" Margin="0,0,0,12"
                    Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Text="{Binding LatestVersion, Mode=OneWay, StringFormat=新しいバージョン {0} が公開されています}" />
                        <TextBlock FontSize="11" Opacity="0.8" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="共同編集は最新のプラグイン同士でのみ利用できます。更新してください。" />
                    </StackPanel>

                    <Button Grid.Column="1" Content="更新ページを開く" Command="{Binding OpenUpdateUrlCommand}"
                            Cursor="Hand" Padding="10,4" Margin="8,0,0,0" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="ルーム" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10" />

                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Button Command="{Binding CreateRoomCommand}" Cursor="Hand" Height="32">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{DynamicResource {x:Static icons:GeometryKeys.Plus}}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                                <TextBlock Text="新しいルームを作成" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <TextBlock Text="既存のルームに参加" FontSize="12" Margin="0,10,0,6" Opacity="0.85" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <PasswordBox x:Name="InputRoomIdPasswordBox" PasswordChanged="OnInputRoomIdPasswordChanged"
                                         PreviewMouseWheel="OnInputPreviewMouseWheel"
                                         Height="25" Padding="6,4" FontSize="12" VerticalContentAlignment="Center" Margin="0" />

                            <Button Grid.Column="1" Command="{Binding JoinFromClipboardCommand}" Cursor="Hand"
                                    Width="30" Height="25" Margin="0" Padding="0" ToolTip="クリップボードのリンクから参加">
                                <Path Data="{DynamicResource {x:Static icons:GeometryKeys.ClipboardOutline}}"
                                      Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                      Width="14" Height="14" Stretch="Uniform" />
                            </Button>

                            <Button Grid.Column="2" Command="{Binding JoinRoomCommand}" Click="OnJoinRoomClick" Cursor="Hand"
                                    Content="参加" Width="60" Height="25" Margin="0" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisConverter}}">
                        <Button Command="{Binding SyncNowCommand}" Cursor="Hand" Height="32" Margin="0,0,0,6"
                                ToolTip="タイムラインの内容をホストの状態に揃え直します">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{DynamicResource {x:Static icons:GeometryKeys.Refresh}}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                                <TextBlock Text="データを同期する" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding DisconnectCommand}" Cursor="Hand" Height="32" Content="切断する" />
                    </StackPanel>

                    <Separator Margin="0,10,0,8" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding CopyRoomIdCommand}" Cursor="Hand" Padding="6,3" Margin="0,0,4,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource {x:Static icons:GeometryKeys.ContentCopy}}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0" />
                                <TextBlock Text="IDをコピー" FontSize="11" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CopyInviteLinkCommand}" Cursor="Hand" Padding="6,3">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource {x:Static icons:GeometryKeys.LinkVariant}}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0" />
                                <TextBlock Text="招待リンクコピー" FontSize="11" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="参加者一覧" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Participants.Count, StringFormat='({0}名)'}" FontSize="12" Opacity="0.75" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Participants}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="6,4" Margin="0,2" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Ellipse Grid.Column="0" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="ユーザーカラー">
                                            <Ellipse.Fill>
                                                <SolidColorBrush Color="{Binding ThemeColor}" />
                                            </Ellipse.Fill>
                                        </Ellipse>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding UserName}" FontSize="12" FontWeight="SemiBold" />
                                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                                <Ellipse Width="6" Height="6" Fill="{Binding StatusBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                <TextBlock Text="{Binding StatusText}" FontSize="10" Opacity="0.75" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Role}" FontSize="11" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <Button Click="OnParticipantMenuClick"
                                                    Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="4,2" ToolTip="ユーザー情報を開く">
                                                <Path Data="{DynamicResource {x:Static icons:GeometryKeys.DotsVertical}}"
                                                      Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                      Width="13" Height="13" Stretch="Uniform" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
