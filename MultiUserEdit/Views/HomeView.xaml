<UserControl x:Class="MultiUserEdit.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:MultiUserEdit.Views.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="400">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        <converters:RoleToPencilVisibilityConverter x:Key="RoleToPencilVisConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
            <!-- タイトル & 接続ステータス -->
            <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="共同編集" FontWeight="Bold" FontSize="14" />
                        <TextBlock Text="{Binding StatusText}" FontSize="12" Margin="0,4,0,0" Opacity="0.8" />
                    </StackPanel>

                    <Border Grid.Column="1" VerticalAlignment="Center" Padding="8,4" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                        <TextBlock FontSize="11" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Text" Value="接続中" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                            <Setter Property="Text" Value="未接続" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>

            <!-- ルーム操作カード -->
            <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="ルーム設定" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10" />

                    <!-- ホスト: ルーム作成 -->
                    <Button Command="{Binding CreateRoomCommand}" Cursor="Hand" Height="32" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Path Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                            <TextBlock Text="新しいルームを作成" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Separator Margin="0,2,0,10" />

                    <!-- ゲスト: ルーム参加 -->
                    <TextBlock Text="既存のルームに参加" FontSize="12" Margin="0,0,0,6" Opacity="0.85" />
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Text="{Binding InputRoomId, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="6,4" FontSize="12" VerticalContentAlignment="Center" Margin="0,0,6,0" />
                        <Button Grid.Column="1" Command="{Binding JoinRoomCommand}" Cursor="Hand" Content="参加" Width="60" Height="28" />
                    </Grid>
                    <Button Command="{Binding JoinFromClipboardCommand}" Cursor="Hand" Padding="6,4" Margin="0,4,0,0" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0" />
                            <TextBlock Text="クリップボードのリンクから参加" FontSize="11" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- 参加者一覧カード -->
            <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="参加者一覧" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Participants.Count, StringFormat='({0}名)'}" FontSize="12" Opacity="0.75" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Participants}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="6,4" Margin="0,2" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Ellipse Grid.Column="0" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="ユーザーカラー">
                                            <Ellipse.Fill>
                                                <SolidColorBrush Color="{Binding ThemeColor}" />
                                            </Ellipse.Fill>
                                        </Ellipse>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding UserName}" FontSize="12" FontWeight="SemiBold" />
                                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                                <Ellipse Width="6" Height="6" Fill="{Binding StatusBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                <TextBlock Text="{Binding StatusText}" FontSize="10" Opacity="0.75" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Role}" FontSize="11" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <!-- ホストのみ、かつ相手がゲストの時だけ表示される権限編集用鉛筆ボタン -->
                                            <Button Click="OnEditParticipantPermissionClick" 
                                                    Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="4,2">
                                                <Button.Visibility>
                                                    <MultiBinding Converter="{StaticResource RoleToPencilVisConverter}">
                                                        <Binding Path="DataContext.IsHost" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                        <Binding Path="Role" />
                                                    </MultiBinding>
                                                </Button.Visibility>
                                                <Path Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z" 
                                                      Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" 
                                                      Width="11" Height="11" Stretch="Uniform" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- セッション情報 -->
            <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1" CornerRadius="4" Padding="12">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="セッション情報" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Command="{Binding CopyRoomIdCommand}" Cursor="Hand" Padding="6,3" Margin="0,0,4,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0" />
                                    <TextBlock Text="IDコピー" FontSize="11" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding CopyInviteLinkCommand}" Cursor="Hand" Padding="6,3">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M3.9,12C3.9,10.29 5.29,8.9 7,8.9H11V7H7A5,5 0 0,0 2,12A5,5 0 0,0 7,17H11V15.1H7C5.29,15.1 3.9,13.71 3.9,12M8,13H16V11H8V13M17,7H13V8.9H17C18.71,8.9 20.1,10.29 20.1,12C20.1,13.71 18.71,15.1 17,15.1H13V17H17A5,5 0 0,0 22,12A5,5 0 0,0 17,7Z" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0" />
                                    <TextBlock Text="招待リンクコピー" FontSize="11" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
                        <TextBlock Text="ルームID: " FontSize="12" Opacity="0.8" />
                        <TextBlock Text="{Binding RoomId}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                    </StackPanel>

                    <!-- 切断ボタン -->
                    <Button Command="{Binding DisconnectCommand}" Cursor="Hand" Height="28" Content="切断する" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
