<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<UseWPF>true</UseWPF>

		<Version>1.2.5</Version>

		<!--Pdb内にソースコードのフルパスを含めない-->
		<RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\'))</RepoRoot>
		<PathMap>$(RepoRoot)=.</PathMap>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<Reference Include="Newtonsoft.Json">
		  <HintPath>$(YMM4RefDirPath)Newtonsoft.Json.dll</HintPath>
		</Reference>
		<Reference Include="YukkuriMovieMaker">
			<HintPath>$(YMM4RefDirPath)YukkuriMovieMaker.dll</HintPath>
		</Reference>
		<Reference Include="YukkuriMovieMaker.Controls">
			<HintPath>$(YMM4RefDirPath)YukkuriMovieMaker.Controls.dll</HintPath>
		</Reference>
		<Reference Include="YukkuriMovieMaker.Plugin">
			<HintPath>$(YMM4RefDirPath)YukkuriMovieMaker.Plugin.dll</HintPath>
		</Reference>
		<Reference Include="ReactiveProperty">
			<HintPath>$(YMM4RefDirPath)ReactiveProperty.dll</HintPath>
		</Reference>
		<Reference Include="ReactiveProperty.Core">
			<HintPath>$(YMM4RefDirPath)ReactiveProperty.Core.dll</HintPath>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\YukkuriMovieMaker.Generator\YukkuriMovieMaker.Generator\YukkuriMovieMaker.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
		<AdditionalFiles Include="**/*.csv" />
	</ItemGroup>

	<Import Project="..\YukkuriMovieMaker.Generator\YukkuriMovieMaker.Generator.targets" />

	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
		<PropertyGroup>
			<PluginOutputDir>$(YMM4DirPath)user\plugin\$(ProjectName)\</PluginOutputDir>
			<SubPluginOutputDir>$(SubYMM4DirPath)user\plugin\$(ProjectName)\</SubPluginOutputDir>
		</PropertyGroup>
		<ItemGroup>
			<SatelliteAssemblyOutput Include="$(TargetDir)**\$(TargetName).resources.dll" />
		</ItemGroup>
		<MakeDir Directories="$(PluginOutputDir)" />
		<Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginOutputDir)" ContinueOnError="WarnAndContinue" />
		<Copy SourceFiles="@(SatelliteAssemblyOutput)" DestinationFiles="@(SatelliteAssemblyOutput->'$(PluginOutputDir)%(RecursiveDir)%(Filename)%(Extension)')" ContinueOnError="WarnAndContinue" />
		<MakeDir Directories="$(SubPluginOutputDir)" Condition="'$(SubYMM4DirPath)' != ''" />
		<Copy SourceFiles="$(TargetPath)" DestinationFolder="$(SubPluginOutputDir)" ContinueOnError="WarnAndContinue" Condition="'$(SubYMM4DirPath)' != ''" />
		<Copy SourceFiles="@(SatelliteAssemblyOutput)" DestinationFiles="@(SatelliteAssemblyOutput->'$(SubPluginOutputDir)%(RecursiveDir)%(Filename)%(Extension)')" ContinueOnError="WarnAndContinue" Condition="'$(SubYMM4DirPath)' != ''" />
	</Target>
</Project>